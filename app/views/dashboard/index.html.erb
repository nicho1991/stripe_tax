<div class="container mx-auto px-4 py-8">
  <div class="hero bg-base-200 rounded-lg p-8 mb-8">
    <div class="hero-content text-center">
      <div class="max-w-md">
        <h1 class="text-4xl font-bold">Welcome to Dashboard</h1>
        <p class="py-4">You're successfully signed in. Start managing your Stripe tax data.</p>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title">Upload Payout CSV</h2>
        <p>Upload your Stripe payout CSV file to get started.</p>
        <div class="card-actions justify-end">
          <button class="btn btn-primary">Upload</button>
        </div>
      </div>
    </div>

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title">Upload Transactions CSV</h2>
        <p>Upload your detailed transactions CSV file.</p>
        <div class="card-actions justify-end">
          <button class="btn btn-primary">Upload</button>
        </div>
      </div>
    </div>

    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title">View Reports</h2>
        <p>View your processed data and summaries.</p>
        <div class="card-actions justify-end">
          <button class="btn btn-primary">View</button>
        </div>
      </div>
    </div>
  </div>
</div>

